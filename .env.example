# Kopiere diese Datei nach ".env" und trage deine eigenen Werte ein.
# Die Datei ".env" wird NICHT auf GitHub hochgeladen (steht in .gitignore).

# Fester Admin-Account: wird bei jedem Start angelegt bzw. mit diesem Passwort versehen.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Optional
# PORT=3000
# DB_FILE=data/bettertennis.db
# SESSION_SECRET=
# CURRENCY=BAM
